{
  "name": "@zed/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared foundation of the ZED React Native apps: V4 mobile API client, session and device info, offline store and sync queue, photo capture and stamping, location, forms and UI theme",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "android",
    "react-native.config.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "jest",
    "lint": "eslint src"
  },
  "codegenConfig": {
    "name": "ZedSharedSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "org.qcin.zed.shared"
    }
  },
  "peerDependencies": {
    "@op-engineering/op-sqlite": "*",
    "@react-native-community/netinfo": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "^29.5.13",
    "@types/sql.js": "^1.4.9",
    "jest": "^29.6.3",
    "react-test-renderer": "19.3.0",
    "sql.js": "^1.15.1",
    "typescript": "^6.0.3"
  }
}
