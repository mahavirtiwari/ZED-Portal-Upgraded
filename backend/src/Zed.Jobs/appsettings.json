{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "ConnectionStrings": {
    "Main": "",
    "Consultancy": "",
    "Surveillance": ""
  },

  "Email": {
    "PickupDirectory": ""
  },

  "Jobs": {
    "_comment": "Schedules: replace with the converted SQL Agent export (tools/jobs/Convert-AgentJobs.ps1, docs/JOBS.md), run Zed.Jobs --check, then set Enabled. Times are in TimeZone. All are off until then.",
    "Databases": [ "Main", "Consultancy", "Surveillance" ],
    "MailPollSeconds": 30,
    "MailBatchSize": 20,
    "MailMaxAttempts": 5,
    "MailProfiles": { "ZedAdmin": "Default" },
    "TimeZone": "Asia/Kolkata",
    "CommandTimeoutSeconds": 1800,
    "Schedules": [
      { "Name": "Update latest certification", "Database": "Main", "Procedure": "SP_JOB_FOR_UPDATE_LATEST_CERTIFICATION", "DailyAt": [], "Enabled": false },
      { "Name": "Enable re-certification", "Database": "Main", "Procedure": "SP_JOB_ENABLE_FOR_RE_CERTIFICATION", "DailyAt": [], "Enabled": false },
      { "Name": "Expire 3-year certifications", "Database": "Main", "Procedure": "SP_JOB_TO_UPDATE_3YEARS_COMPLETED_TO_EXPIRED", "DailyAt": [], "Enabled": false },
      { "Name": "Suspend ZED IDs in surveillance", "Database": "Main", "Procedure": "SP_JOB_FOR_SUSPENDING_ZEDIDS_IN_SURVEILLANCE", "DailyAt": [], "Enabled": false },
      { "Name": "Website counts", "Database": "Main", "Procedure": "SP_DAILY_RUN_WEB_SITE_COUNTS", "DailyAt": [], "Enabled": false },
      { "Name": "ERP auto reconciliation", "Database": "Main", "Procedure": "Sp_Daily_ERP_Auto_Reconciliation", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: apply for surveillance", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_APPLY_FOR_SURVEILLANCE_MAIL", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: apply for surveillance, reminder 1", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_APPLY_FOR_SURVEILLANCE_MAIL_REM1", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: apply for surveillance, reminder 2", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_APPLY_FOR_SURVEILLANCE_MAIL_REM2", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: apply for Bronze surveillance", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_APPLY_FOR_BRONZE_SURVEILLANCE_MAIL", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: apply for Bronze surveillance, reminder 1", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_APPLY_FOR_BRONZE_SURVEILLANCE_MAIL_REM1", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: apply for Bronze surveillance, reminder 2", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_APPLY_FOR_BRONZE_SURVEILLANCE_MAIL_REM2", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: apply for second surveillance", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_APPLY_FOR_SECOND_SURVEILLANCE_MAIL", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: apply for second surveillance, reminder 1", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_APPLY_FOR_SECOND_SURVEILLANCE_MAIL_REM1", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: apply for second surveillance, reminder 2", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_APPLY_FOR_SECOND_SURVEILLANCE_MAIL_REM2", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: re-certification", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_AUTO_MAIL_FOR_CERTIFICATE_RECERTIFICATION", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: certificate suspension", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_AUTO_MAIL_FOR_CERTIFICATE_SUSPENSION", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: certificate withdrawal", "Database": "Main", "Procedure": "SP_JOB_TO_SEND_AUTO_MAIL_FOR_CERTIFICATE_WITHDRAW", "DailyAt": [], "Enabled": false },
      { "Name": "Mail: agency status counts", "Database": "Main", "Procedure": "SP_SEND_MAIL_STATUS_COUNTS_AGENCY", "DailyAt": [], "Enabled": false },
      { "Name": "Surveillance: insert surveillance data", "Database": "Surveillance", "Procedure": "SP_JOB_FOR_INSERT_SURVEILLANCE_DATA", "DailyAt": [], "Enabled": false },
      { "Name": "Surveillance: insert Bronze surveillance data", "Database": "Surveillance", "Procedure": "SP_JOB_FOR_INSERT_BRONZE_SURVEILLANCE_DATA", "DailyAt": [], "Enabled": false },
      { "Name": "Auto-reject expired NCs", "Database": "Main", "Procedure": "SP_AUTO_FINAL_REJECT_EXPIRED_NC", "DailyAt": [], "Enabled": false, "Note": "Candidate: no parameters, called by nothing; confirm in the Agent export (docs/JOBS.md)." },
      { "Name": "Surveillance: auto-reject expired NCs", "Database": "Surveillance", "Procedure": "SP_AUTO_FINAL_REJECT_EXPIRED_NC", "DailyAt": [], "Enabled": false, "Note": "Candidate: no parameters, called by nothing; confirm in the Agent export (docs/JOBS.md)." },
      { "Name": "Surveillance: auto-reject Bronze surveillance before expiry", "Database": "Surveillance", "Procedure": "SP_AUTO_REJECT_BRONZE_SURVEILLANCE_BEFORE_EXPIRY", "DailyAt": [], "Enabled": false, "Note": "Candidate: no parameters, called by nothing; confirm in the Agent export (docs/JOBS.md)." },
      { "Name": "Surveillance: apply Bronze surveillance from backend, by state", "Database": "Surveillance", "Procedure": "SP_APPLY_BRONZE_SURVEILLANCE_FROM_BACKEND_BY_STATE_DISTRICT", "DailyAt": [], "Enabled": false, "Note": "Needs @StateName, which the job runner cannot pass: do not enable (docs/JOBS.md)." },
      { "Name": "Surveillance: apply Bronze surveillance from backend, by state and priority", "Database": "Surveillance", "Procedure": "SP_BACKEND_APPLY_BRONZE_SURVEILLANCE_BY_STATE_PRIORITY", "DailyAt": [], "Enabled": false, "Note": "Needs @StateName, which the job runner cannot pass: do not enable (docs/JOBS.md)." }
    ],
    "FolderRename": {
      "Note": "Replaces SP_JOB_TO_CREATE_RENAMING_BATCH_FILES (no xp_cmdshell). Migration 0007 first; start in Report mode; docs/JOBS.md. Paths: the two folders the old job renamed in (old web server); use the server's own paths.",
      "Enabled": false,
      "Mode": "Report",
      "DailyAt": [ "01:30" ],
      "DelayHours": 2,
      "CertificationTypes": [ "Bronze" ],
      "GraceMinutes": 10,
      "Roots": [
        { "Name": "SA PDFs", "Path": "E:\\Publish\\ZEDCS_LIVE\\ZEDCS_V2_LIVE\\PDFs\\SA", "PerLevel": false },
        { "Name": "App photos", "Path": "E:\\Publish\\ZEDCS_LIVE\\ZEDCS_V2_LIVE_SERVICES\\Photos", "PerLevel": false }
      ]
    }
  }
}
