@* 2026-11-20 (incentive schemes): to the MSME when an onsite assessor is named for its application (an onsite visit is due). Editable under Admin → Email Templates → Incentive mails. *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir,</p>
    <p style="font-size: 13px; margin-bottom: 0;">Your application for <b>@SchemeName</b> has passed the desktop verification. An assessor will visit your unit for the onsite verification. The details are as follows:</p>
    <StaffSchemeDetailTable Rows="@Rows" />
    <p style="font-size: 13px; margin-bottom: 0;">Please keep the documents and the items of your application ready for verification.</p>
    <p style="font-size: 13px; margin-bottom: 0;">In case of any query, please mail us at: zed.support@qcin.org. Please mention your ZED ID in all your correspondence.</p>
    <p style="font-size: 13px; margin-bottom: 20px;">Thanks and Regards,<br>ZED Team</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string ZedId { get; set; } = "";
    [Parameter] public string UnitName { get; set; } = "";
    [Parameter] public string SchemeName { get; set; } = "";
    [Parameter] public string AssessorName { get; set; } = "";
    [Parameter] public string AssessorMobile { get; set; } = "";
    [Parameter] public string AgencyName { get; set; } = "";
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";

    private IReadOnlyList<StaffSchemeDetailTable.Row> Rows =>
        [new("MSME ZED ID", ZedId), new("Unit Name", UnitName), new("Scheme", SchemeName), new("Assessor Name", AssessorName), new("Assessor Mobile", AssessorMobile), new("Agency", AgencyName)];
}
