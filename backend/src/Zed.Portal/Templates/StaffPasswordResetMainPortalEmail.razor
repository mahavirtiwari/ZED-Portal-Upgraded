@* Surveillance "Forgot password?" for an account whose password the main portal holds (SECURITY-FINDINGS #111, docs/PASSWORDS.md). *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir, </p>
    <p style="font-size: 13px; margin-bottom: 0;">Greetings of the day!</p>
    <p style="font-size: 13px; margin-bottom: 0;">You or someone asked to reset the password of the following account on the ZED Surveillance portal:</p>
    <table style="width: 100%; table-layout: fixed; font-size: 13px; border: 1px #dee1e4 solid; background: #f7f8f9;" cellpadding="0" cellspacing="0" border="0">
        <tbody>
            <tr>
                <td style="padding: 6px; width: 30%; font-size: 13px; text-align: right; color: #999; padding-right: 20px;">User Name</td>
                <td>@UserName</td>
            </tr>
            <tr>
                <td style="padding: 6px; width: 30%; font-size: 13px; text-align: right; color: #999; padding-right: 20px;">User ID</td>
                <td>@UserId</td>
            </tr>
        </tbody>
    </table>
    <p style="font-size: 13px; margin-bottom: 0;">This account uses the password of the main ZED portal. Please use "Forgot password?" on the main portal's user login; the new password then works on both portals.</p>
    <div style="text-align: center; padding: 30px 0;">
        <a href="@MainLoginUrl" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #555555; text-decoration: none; border-radius: 4px; text-align: center;">Open the main portal login</a>
    </div>
    <p style="font-size: 13px; margin-bottom: 0;">If you did not ask for this, ignore this e-mail: your password stays unchanged.</p>
    <p style="font-size: 13px; margin-bottom: 20px;">Thanks and Regards,<br>ZED Team</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string UserName { get; set; } = "";
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter, EditorRequired] public string MainLoginUrl { get; set; } = "";
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";
}
