@* Port of _AgencyRegisterTemplate.cshtml (welcome mail of a new assessment agency, or on Consultancy of a new Consultant Organisation; sent once). *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir, </p>
    <p style="font-size: 13px; margin-bottom: 0;">Greetings of the day!</p>
    <p style="font-size: 13px; margin-bottom: 0;">Thank you for registering as @(Consultancy ? "a Consultant Organisation" : "an Assessment Agency") under the "MSME Sustainable (ZED) Certification" Scheme.<br />Your login details are as follows:</p>
    <table style="width: 100%; table-layout: fixed; font-size: 13px; padding: 15px; background: #F0F0F0;" cellpadding="0" cellspacing="0" border="0">
        <tbody bgcolor="#ffffff">
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">@(Consultancy ? "Activity Involved" : "Mode of Assessment")</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">
                    @if (Consultancy)
                    {
                        @if (DesktopVerification || SiteVerification) { <span>Handholding Support</span><br /> }
                        @if (FinancialVerification) { <span>Technology Upgradation</span> }
                    }
                    else
                    {
                        @if (DesktopVerification) { <span>Desktop Verification</span><br /> }
                        @if (SiteVerification) { <span>Site Verification</span><br /> }
                        @if (FinancialVerification) { <span>Financial Assistance Verification</span> }
                    }
                </td>
            </tr>
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">@(Consultancy ? "Registered Consultant Organisation Name" : "Registered Assessment Agency Name")</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@UserName</td>
            </tr>
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">User ID</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@UserId</td>
            </tr>
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Password</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@Password</td>
            </tr>
        </tbody>
    </table>
    <table style="width: 100%; table-layout: fixed; font-size: 13px;padding: 15px;  background: #F0F0F0;" cellpadding="0" cellspacing="0" border="0">
        <tbody bgcolor="#ffffff">
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Spoc Name</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@SpocName</td>
            </tr>
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Spoc Mobile No.</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@MobileNo</td>
            </tr>
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Spoc Email ID</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@EmailId</td>
            </tr>
        </tbody>
    </table>
    <span style="font-size: 12px; line-height: 20px; margin-top: 10px; display: inline-block; margin-bottom: 10px; color: #999;">(Please use the @(Consultancy ? "Consultant Organisation" : "Registered Assessment Agency") User ID in all your future communication regarding ZED)</span>
    <p style="font-size: 13px; margin-bottom: 0;">Please change this password after your first login (Change Password in the menu under your name).</p>
    <div style="text-align: center; padding: 30px 0;">
        <a href="@LoginUrl" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #555555; text-decoration: none; border-radius: 4px; text-align: center;">Click here to Login</a>
    </div>
    <p style="font-size: 13px; margin-bottom: 0;">In case of any query, please mail us at: zed.support@qcin.org.</p>
    <p style="font-size: 13px; margin-bottom: 20px;">Thanks and Regards,<br>ZED Team</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string UserName { get; set; } = "";
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter, EditorRequired] public string Password { get; set; } = "";
    [Parameter] public string? SpocName { get; set; }
    [Parameter] public string? MobileNo { get; set; }
    [Parameter] public string? EmailId { get; set; }
    [Parameter] public bool DesktopVerification { get; set; }
    [Parameter] public bool SiteVerification { get; set; }
    [Parameter] public bool FinancialVerification { get; set; }
    [Parameter, EditorRequired] public string LoginUrl { get; set; } = "";
    /// <summary>Consultancy (handholding) wording: Consultant Organisation, Handholding Support / Technology Upgradation.</summary>
    [Parameter] public bool Consultancy { get; set; }
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";
}
