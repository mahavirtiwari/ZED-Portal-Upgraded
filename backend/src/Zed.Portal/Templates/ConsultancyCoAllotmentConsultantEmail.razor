@* Port of the consultancy _SaAllotUnitToLeadAssessorTemplate / _SaAllotUnitToCoAssessorTemplate.cshtml (one mail to the
   lead consultant and one to each co-consultant). The old mails printed the consultant's password
   (CoAssessorPassword, SECURITY-FINDINGS #35); this one does not. *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir,</p>
    <p style="font-size: 13px; margin-bottom: 0;">Greetings of the day!</p>
    <p style="font-size: 13px; margin-bottom: 0;">You have been allocated a Handholding Support (Milestone @Milestone) as @Role under "MSME Sustainable (ZED) Certification" Scheme. The details are as follows:</p>
    <table style="width: 100%; table-layout: fixed; font-size: 13px; padding: 15px; background: #F0F0F0;" cellpadding="0" cellspacing="0" border="0">
        <tbody bgcolor="#ffffff">
            <tr><td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">MSME ZED ID</td><td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@ZedId</td></tr>
            <tr><td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Unit Name</td><td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@UnitName</td></tr>
            <tr><td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Unit Address</td><td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@UnitAddress</td></tr>
            <tr><td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Stage</td><td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@ConsultancyCoAllotmentDates.Stage(Milestone)</td></tr>
            <tr><td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Consultant ID</td><td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@ConsultantId</td></tr>
            <tr><td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Handholding Dates</td><td style="border-bottom:2px solid #f0f0f0;font-weight: 700;"><ConsultancyCoAllotmentDates Milestone="@Milestone" BdsFromDate="@BdsFromDate" BdsToDate="@BdsToDate" HapFromDate="@HapFromDate" HapToDate="@HapToDate" /></td></tr>
        </tbody>
    </table>
    <p style="font-size: 13px; margin-bottom: 0;">Please sign in to the Mobile App and the web module with your Consultant ID, the MSME ZED ID and your existing password. If you do not remember it, use "Forgot Password" on the login page.</p>
    <p style="font-size: 13px; margin-bottom: 0;">Please download the Mobile Application to proceed (the same can also be downloaded directly from Google Play Store):</p>
    <div style="text-align: center; padding: 30px 0;">
        <a href="https://play.google.com/store/apps/details?id=com.qci.zed.consultancy" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #45A5AD; text-decoration: none; border-radius: 4px; text-align: center;">Download Mobile Application</a>
    </div>
    <p style="font-size: 13px; margin-bottom: 0px;">Thanks and Regards,</p>
    <p style="font-size: 13px; margin-bottom: 20px;">ZED Team</p>
</EmailLayout>

@code {
    /// <summary>"Lead Consultant" or "Co-consultant".</summary>
    [Parameter, EditorRequired] public string Role { get; set; } = "";
    [Parameter, EditorRequired] public string Milestone { get; set; } = "";
    [Parameter, EditorRequired] public string ZedId { get; set; } = "";
    [Parameter] public string? UnitName { get; set; }
    [Parameter] public string? UnitAddress { get; set; }
    [Parameter, EditorRequired] public string ConsultantId { get; set; } = "";
    [Parameter] public string? BdsFromDate { get; set; }
    [Parameter] public string? BdsToDate { get; set; }
    [Parameter] public string? HapFromDate { get; set; }
    [Parameter] public string? HapToDate { get; set; }
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";
}
