@* Port of _BlockOrUnblockBronzeAssessmentTemplate.cshtml. *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir, </p>
    <p style="font-size: 13px; margin-bottom: 0;">Greetings of the day!</p>
    @if (Allowed)
    {
        <p style="font-size: 13px; margin-bottom: 0;">Your account has been enabled for Bronze assessments under the "MSME Sustainable (ZED) Certification" Scheme.<br /></p>
    }
    else
    {
        <p style="font-size: 13px; margin-bottom: 0;">Your account has been temporarily disabled for Bronze assessments under the "MSME Sustainable (ZED) Certification" Scheme.<br /></p>
    }
    <table style="width: 100%; table-layout: fixed; font-size: 13px; padding: 15px; background: #F0F0F0;" cellpadding="0" cellspacing="0" border="0">
        <tbody bgcolor="#ffffff">
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Assessment Agency Name</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@UserName</td>
            </tr>
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">User ID</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@UserId</td>
            </tr>
            @if (!Allowed)
            {
                <tr>
                    <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Reason</td>
                    <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@Reason</td>
                </tr>
            }
        </tbody>
    </table>
    <table style="width: 100%; table-layout: fixed; font-size: 13px;padding: 15px;  background: #F0F0F0;" cellpadding="0" cellspacing="0" border="0">
        <tbody bgcolor="#ffffff">
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Spoc Name</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@SpocName</td>
            </tr>
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Spoc Mobile No.</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@MobileNo</td>
            </tr>
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Spoc Email ID</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@EmailId</td>
            </tr>
        </tbody>
    </table>
    <span style="font-size: 12px; line-height: 20px; margin-top: 10px; display: inline-block; margin-bottom: 10px; color: #999;">(Please use the Registered Assessment Agency User ID in all your future communication regarding ZED)</span>
    <div style="text-align: center; padding: 30px 0;">
        <a href="@LoginUrl" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #555555; text-decoration: none; border-radius: 4px; text-align: center;">Click here to Login</a>
    </div>
    <p style="font-size: 13px; margin-bottom: 0;">In case of any query, please mail us at: zed.support@qcin.org.</p>
    <p style="font-size: 13px; margin-bottom: 20px;">Thanks and Regards,<br>ZED Team</p>
</EmailLayout>

@code {
    [Parameter] public bool Allowed { get; set; }
    [Parameter, EditorRequired] public string UserName { get; set; } = "";
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter] public string? Reason { get; set; }
    [Parameter] public string? SpocName { get; set; }
    [Parameter] public string? MobileNo { get; set; }
    [Parameter] public string? EmailId { get; set; }
    [Parameter, EditorRequired] public string LoginUrl { get; set; } = "";
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";
}
