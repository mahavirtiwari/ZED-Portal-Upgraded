@* Staff password reset link (V4; the old sites had no staff reset). The link's token is only in this mail. *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir, </p>
    <p style="font-size: 13px; margin-bottom: 0;">Greetings of the day!</p>
    @if (string.IsNullOrEmpty(SentBy))
    {
        <p style="font-size: 13px; margin-bottom: 0;">You or someone requested to reset the password of the following account:</p>
    }
    else
    {
        <p style="font-size: 13px; margin-bottom: 0;">A ZED administrator (@SentBy) has sent you a link to set a new password for the following account:</p>
    }
    <table style="width: 100%; table-layout: fixed; font-size: 13px; border: 1px #dee1e4 solid; background: #f7f8f9;" cellpadding="0" cellspacing="0" border="0">
        <tbody>
            <tr>
                <td style="padding: 6px; width: 30%; font-size: 13px; text-align: right; color: #999; padding-right: 20px;">User Name</td>
                <td>@UserName</td>
            </tr>
            <tr>
                <td style="padding: 6px; width: 30%; font-size: 13px; text-align: right; color: #999; padding-right: 20px;">User ID</td>
                <td>@UserId</td>
            </tr>
        </tbody>
    </table>
    <div style="text-align: center; padding: 30px 0;">
        <a href="@ResetUrl" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #01A08D; text-decoration: none; border-radius: 4px; text-align: center;">Set a New Password</a>
    </div>
    <p style="font-size: 13px; margin-bottom: 0;">The link works once, for @ValidMinutes minutes. A newer link replaces it.</p>
    <p style="font-size: 13px; margin-bottom: 0;">If you did not ask for this, ignore this e-mail: your password stays unchanged. If you receive such mails repeatedly, inform zed.support@qcin.org.</p>
    <p style="font-size: 13px; margin-bottom: 0;">ZED will never ask you for your password.</p>
    <p style="font-size: 13px; margin-bottom: 20px;">Thanks and Regards,<br>ZED Team</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string UserName { get; set; } = "";
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter, EditorRequired] public string ResetUrl { get; set; } = "";
    [Parameter, EditorRequired] public int ValidMinutes { get; set; }
    /// <summary>User ID of the administrator who sent the link; null for "Forgot password?".</summary>
    [Parameter] public string? SentBy { get; set; }
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";
}
