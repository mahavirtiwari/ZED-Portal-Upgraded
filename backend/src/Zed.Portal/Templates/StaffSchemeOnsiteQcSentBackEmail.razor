@* 2026-11-20 (incentive schemes): to the onsite assessor when the onsite agency sends an application back from the final QC. Editable under Admin → Email Templates → Incentive mails. *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir,</p>
    <p style="font-size: 13px; margin-bottom: 0;">Your agency has sent an application for <b>@SchemeName</b> back from the onsite QC. Please complete the onsite verification again in the ZED assessor app. The details are as follows:</p>
    <StaffSchemeDetailTable Rows="@Rows" />
    <div style="text-align: center; padding: 30px 0;">
        <a href="@LoginUrl" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #555555; text-decoration: none; border-radius: 4px; text-align: center;">Click here to Login</a>
    </div>
    <p style="font-size: 13px; margin-bottom: 0;">In case of any query, please mail us at: zed.support@qcin.org.</p>
    <p style="font-size: 13px; margin-bottom: 20px;">Thanks and Regards,<br>ZED Team</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string ZedId { get; set; } = "";
    [Parameter] public string UnitName { get; set; } = "";
    [Parameter] public string SchemeName { get; set; } = "";
    [Parameter] public string Remarks { get; set; } = "";
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";

    private string LoginUrl => PublicBaseUrl.TrimEnd('/') + "/login";

    private IReadOnlyList<StaffSchemeDetailTable.Row> Rows =>
        [new("MSME ZED ID", ZedId), new("Unit Name", UnitName), new("Scheme", SchemeName), new("QC Remarks", Remarks)];
}
