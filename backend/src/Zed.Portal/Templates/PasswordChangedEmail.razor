@* Port of _ChangePwdTemplate.cshtml. The legacy mail repeated the new password in clear text; it no longer does. *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir, </p>
    <p style="font-size: 13px; margin-bottom: 0;">Greetings of the day!</p>
    <p style="font-size: 13px; margin-bottom: 0;">Your password has been changed. Your login details are as follows:</p>
    <table style="width: 100%; table-layout: fixed; font-size: 13px; border: 1px #dee1e4 solid; background: #f7f8f9;" cellpadding="0" cellspacing="0" border="0">
        <tbody>
            <tr>
                <td style="padding: 6px; width: 50%; font-size: 13px; text-align: right; color: #999; padding-right: 20px;">User Name</td>
                <td>@UserName</td>
            </tr>
            <tr>
                <td style="padding: 6px; width: 50%; font-size: 13px; text-align: right; color: #999; padding-right: 20px;">User ID</td>
                <td>@UserId</td>
            </tr>
        </tbody>
    </table>
    <span style="font-size: 12px; line-height: 20px; margin-top: 10px; display: inline-block; margin-bottom: 10px; color: #999;">(Please use the User ID in all your future communication regarding ZED)</span>
    <p style="font-size: 13px; margin-bottom: 0;">If you did not change your password, contact zed.support@qcin.org immediately.</p>
    <div style="text-align: center; padding: 30px 0;">
        <a href="@LoginUrl" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #555555; text-decoration: none; border-radius: 4px; text-align: center;">Click here to Login</a>
    </div>
    <p style="font-size: 13px; margin-bottom: 0px;">Thanks and Regards,</p>
    <p style="font-size: 13px; margin-bottom: 20px;">ZED Team</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string UserName { get; set; } = "";
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter] public bool IsMsme { get; set; }
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";

    private string LoginUrl => PublicBaseUrl.TrimEnd('/') + (IsMsme ? "/msme/login" : "/login");
}
