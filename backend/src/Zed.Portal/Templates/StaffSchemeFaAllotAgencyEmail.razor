@* Port of _FaAllotCbTemplate.cshtml (FinancialAssistanceController.AllotCb): to the agency. *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir,</p>
    <p style="font-size: 13px; margin-bottom: 0;">Greetings of the day!</p>
    <p style="font-size: 13px; margin-bottom: 0;">An application for verification has been allocated to you for Financial Assistance on <span>@CategoryOfCertificate</span>. The details are as follows:</p>
    <StaffSchemeDetailTable Rows="@Rows" />
    <span style="font-size: 13px; margin-bottom: 0;">Please log-in to your account in order to <strong>Accept or Reject</strong> this allocation within 48 hrs.</span>
    <div style="text-align: center; padding: 30px 0;">
        <a href="@LoginUrl" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #555555; text-decoration: none; border-radius: 4px; text-align: center;">Click here to Login</a>
    </div>
    <p style="font-size: 13px; margin-bottom: 0;">In case of any query, please mail us at: zed.support@qcin.org. Please mention your Agency ID in all your correspondence.</p>
    <p style="font-size: 13px; margin-bottom: 0px;">Thanks and Regards,</p>
    <p style="font-size: 13px; margin-bottom: 20px;">ZED Team</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string ZedId { get; set; } = "";
    [Parameter] public string UnitName { get; set; } = "";
    [Parameter] public string Address { get; set; } = "";
    [Parameter] public string CategoryOfCertificate { get; set; } = "";
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";

    private string LoginUrl => PublicBaseUrl.TrimEnd('/') + "/login";

    private IReadOnlyList<StaffSchemeDetailTable.Row> Rows =>
        [new("MSME ZED ID", ZedId), new("Unit Name", UnitName), new("Unit Address", Address), new("Assessment Type", "Financial Assistance")];
}
