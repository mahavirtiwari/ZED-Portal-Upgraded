@* Port of _PledgeCertificateTemplate.cshtml *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir, <br>Greetings of the day!</p>
    <p style="font-size: 13px; margin-bottom: 0;">Thank you for registering your Enterprise and taking the ZED-Pledge for your Unit under the "MSME Sustainable (ZED) Certification" Scheme notified by Ministry of Micro, Small &amp; Medium Enterprises, Government of India. Your Pledge Certificate is on your ZED dashboard: sign in to view it and download it as a PDF for your records.</p>
    <p style="font-size: 14px; margin-bottom: 0;">Your login details are as follows:</p>
    <table style="width: 100%; table-layout: fixed; font-size: 13px; padding: 15px; background: #F0F0F0;" cellpadding="0" cellspacing="0" border="0">
        <tbody bgcolor="#ffffff">
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Unit Name</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@UnitName</td>
            </tr>
            <tr>
                <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">ZED ID</td>
                <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@ZedId</td>
            </tr>
            @if (!string.IsNullOrEmpty(Password))
            {
                <tr>
                    <td style="border-bottom:2px solid #f0f0f0;padding: 15px; width: 30%; font-size: 13px; text-align: left; padding-right: 20px;">Password</td>
                    <td style="border-bottom:2px solid #f0f0f0;font-weight: 700;">@Password</td>
                </tr>
            }
        </tbody>
    </table>
    @if (!string.IsNullOrEmpty(Password))
    {
        <span style="font-size: 12px; line-height: 20px; margin-top: 10px; display: inline-block; margin-bottom: 10px; color: #333;">(Please use your ZED ID in all future correspondence for this Scheme. We recommend changing this password after your first login.)</span><br />
    }
    else
    {
        <span style="font-size: 12px; line-height: 20px; margin-top: 10px; display: inline-block; margin-bottom: 10px; color: #333;">(Please use your ZED ID in all future correspondence for this Scheme.)</span><br />
    }
    @* V4: the office copy and the Udyami Bharat registration carry no password. *@
    @if (OfficeCopy)
    {
        <p style="font-size: 13px; margin-bottom: 0;">Office copy: the login password was sent to the unit only.</p>
    }
    else if (!string.IsNullOrEmpty(SetPasswordUrl))
    {
        <p style="font-size: 13px; margin-bottom: 0;">To sign in, please set your password with the link below. The link can be used once, within @SetPasswordValidHours hours. After that, use "Forgot password" on the MSME login page with your ZED ID.</p>
        <div style="text-align: center; padding: 20px 0 0;">
            <a href="@SetPasswordUrl" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #01A08D; text-decoration: none; border-radius: 4px; text-align: center;">Set Password</a>
        </div>
    }
    else if (string.IsNullOrEmpty(Password))
    {
        <p style="font-size: 13px; margin-bottom: 0;">To sign in, please set your password with "Forgot password" on the MSME login page, using your ZED ID.</p>
    }
    <span style="font-size: 13px; line-height: 20px; margin-top: 10px; display: inline-block; margin-bottom: 10px;">You are now eligible for the following incentives:</span>
    <ul style="font-size: 13px; line-height: 20px; margin: 0 0 10px;"><li>Joining reward of Rs. 10,000/- for ZED Certification.</li></ul>
    <span style="font-size: 13px; line-height: 20px; margin-top: 10px; display: inline-block; margin-bottom: 10px;">The Ministry has instituted various other benefits and incentives which you can avail after completing any one ZED Certification Level (Bronze, Silver or Gold).</span>
    <div style="text-align: center; padding: 30px 0;">
        <a href="@(PublicBaseUrl.TrimEnd('/'))/msme/login" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #45A5AD; text-decoration: none; border-radius: 4px; text-align: center;">Click here to Login</a>
        @* V4: no PDF attached; the certificate page draws it (sign-in first). *@
        <a href="@(PublicBaseUrl.TrimEnd('/'))/msme/pledge-certificate" target="_blank" style="display: block; margin: 12px auto 0; width: 300px; line-height: 42px; color: #45A5AD; background-color: #ffffff; border: 1px solid #45A5AD; text-decoration: none; border-radius: 4px; text-align: center;">View / Download Pledge Certificate</a>
    </div>
    <p style="font-size: 13px; margin-bottom: 0;">In case of any query, please mail us at: zed.support@qcin.org.</p>
    <p style="font-size: 13px; margin-bottom: 20px;">Thanks and Regards,<br>ZED Team</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string UnitName { get; set; } = "";
    [Parameter, EditorRequired] public string ZedId { get; set; } = "";
    /// <summary>The first password (web and app registration, to the unit only); none in the office copy and the Udyami Bharat mail.</summary>
    [Parameter] public string? Password { get; set; }
    /// <summary>Udyami Bharat: a one-time link to set the first password (the MSME password-reset link).</summary>
    [Parameter] public string? SetPasswordUrl { get; set; }
    [Parameter] public int SetPasswordValidHours { get; set; }
    /// <summary>The copy for the office mailbox (Email Settings), without the password.</summary>
    [Parameter] public bool OfficeCopy { get; set; }
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";
}
