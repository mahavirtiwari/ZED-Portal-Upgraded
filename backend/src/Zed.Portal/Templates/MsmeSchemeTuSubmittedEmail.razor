@* Port of _TuSubmitDetailsTemplate.cshtml (TechnologyUpgradation/SubmitFinancialData): to the MSME. *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir,</p>
    <p style="font-size: 13px; margin-bottom: 0;">Greetings of the day!</p>
    <p style="font-size: 13px; margin-bottom: 0;">Thank you for submitting the Application for Financial Support for Zero Effect Solution.</p>
    <p style="font-size: 13px; margin-bottom: 0;">You shall soon be notified on the way forward.</p>
    <p style="font-size: 13px; margin-bottom: 0;">In case of any query, please mail us at: zed.support@qcin.org. Please mention your ZED ID (<b>@ZedId</b>) in all your future correspondence.</p>
    <p style="font-size: 13px; margin-bottom: 20px;">Thanks and Regards,<br>ZED Team</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string ZedId { get; set; } = "";
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";
}
