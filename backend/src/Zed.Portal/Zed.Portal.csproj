<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Portal features shared by the Main, Consultancy and Surveillance APIs: controllers, mail templates
       and document assets. Each host picks its database and the features it serves (PortalSystem). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zed.Portal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The usings the Web SDK adds implicitly; the feature code was written in a web project. -->
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Certificate templates, report images, logo: read from the host's output folder (AppContext.BaseDirectory). -->
    <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zed.Main.Api.Tests" />
    <InternalsVisibleTo Include="Zed.Consultancy.Api.Tests" />
    <InternalsVisibleTo Include="Zed.Surveillance.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zed.Core\Zed.Core.csproj" />
  </ItemGroup>

</Project>
