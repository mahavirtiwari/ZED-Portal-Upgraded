@* Replaces _ChangePwdTemplate.cshtml, which mailed the new password in clear text. This mail only says that the password changed. *@
<EmailLayout PublicBaseUrl="@PublicBaseUrl">
    <p style="font-size: 13px; margin-bottom: 0;">Dear Madam/Sir, </p>
    <p style="font-size: 13px; margin-bottom: 0;">Greetings of the day!</p>
    <p style="font-size: 13px; margin-bottom: 0;">The password of your ZED account was changed from the ZED mobile app.</p>
    <table style="width: 100%; table-layout: fixed; font-size: 13px; border: 1px #dee1e4 solid; background: #f7f8f9;" cellpadding="0" cellspacing="0" border="0">
        <tbody>
            <tr>
                <td style="padding: 6px; width: 50%; font-size: 13px; text-align: right; color: #999; padding-right: 20px;">User Name</td>
                <td>@UserName</td>
            </tr>
            <tr>
                <td style="padding: 6px; width: 50%; font-size: 13px; text-align: right; color: #999; padding-right: 20px;">ZED ID</td>
                <td>@UserId</td>
            </tr>
        </tbody>
    </table>
    <p style="font-size: 13px; margin-bottom: 0;">If you did not change your password, reset it from the login page and contact zed.support@qcin.org immediately.</p>
    <div style="text-align: center; padding: 30px 0;">
        <a href="@(PublicBaseUrl.TrimEnd('/'))/msme/login" target="_blank" style="display: block; margin: 0 auto; width: 300px; line-height: 42px; color: #ffffff; background-color: #555555; text-decoration: none; border-radius: 4px; text-align: center;">Click here to Login</a>
    </div>
    <p style="font-size: 13px; margin-bottom: 0px;">Thanks and Regards,</p>
    <p style="font-size: 13px; margin-bottom: 20px;">ZED Team</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string UserName { get; set; } = "";
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter, EditorRequired] public string PublicBaseUrl { get; set; } = "";
}
