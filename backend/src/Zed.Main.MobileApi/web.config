<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting (mobile services: /mobileapi, /Consultancymobileapi or /surveillancemobileapi, one deployment each with Mobile:System). dotnet publish fills in processPath/arguments. No settings or secrets here: they are
  environment variables of the app pool (deploy/Install-ZedIis.ps1). inheritInChildApplications="false" keeps this
  handler out of the applications below this one (none expected).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdout logging is for diagnosing a host that will not start: switch it on, read logs\stdout_*, switch it off. -->
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Keep equal to Mobile:MaxRequestBytes (default 30 MiB): IIS refuses larger requests before the app sees them. -->
          <requestLimits maxAllowedContentLength="31457280" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
