<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting (main portal, IIS application /). dotnet publish fills in processPath/arguments. No settings or secrets here: they are
  environment variables of the app pool (deploy/Install-ZedIis.ps1). inheritInChildApplications="false" keeps this
  handler out of the applications below this one (e.g. /Consultancy, /surveillance and the mobile services).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdout logging is for diagnosing a host that will not start: switch it on, read logs\stdout_*, switch it off. -->
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- IIS refuses larger requests before the app sees them. The endpoints set their own, smaller limits (largest: the TU open meeting, about 135 MB); 150 MiB here. -->
          <requestLimits maxAllowedContentLength="157286400" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
